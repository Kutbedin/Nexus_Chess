# Copy to .env.local (never committed) and fill in. Every value is optional;
# without them the app runs fully local, exactly like CI.

# Cloud progress backup (Supabase, anonymous sign-in). See docs/supabase-setup.md.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Shows the "link account" teaser on the About page (not functional yet).
VITE_ACCOUNT_LINKING=false

# Analytics (PostHog EU, cookieless). Off in school mode.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Force school mode for the whole build (no analytics, no cloud backup).
VITE_SCHOOL_MODE=false
